{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ximi Ultimate Tool",
  "version": "1.0.0",
  "identifier": "com.iprjkt.ximiultimatetool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ximi Ultimate Tool",
        "width": 1180,
        "height": 800,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
